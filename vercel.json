{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/playground",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/hook-generation-harness.ts": {
      "includeFiles": "{agent_prompt/agent_hook.md,agent_prompt/agent_hook_research.md,agent_prompt/agent_hook_highlight.md,agent_prompt/agent_ugc_script.md}",
      "maxDuration": 900
    },
    "api/hook-agent-prompt.ts": {
      "includeFiles": "agent_prompt/agent_hook.md"
    },
    "api/artwork-generation.ts": {
      "includeFiles": "{agent_prompt/agent_image.md,agent_prompt/agent_artwork_reference.md,agent_prompt/agent_creative_graphic_designer.md,agent_prompt/agent_design_system.md,agent_prompt/agent_production_brief.md,graphic-ad-design-system/03_MASTER_CREATIVE_DIRECTOR_AGENT.md}"
    }
  }
}
